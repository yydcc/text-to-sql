# Existing PostgreSQL server; use a role limited to SELECT on approved business tables.
# URL-encode special characters in username/password. SSL mode depends on your server.
DATABASE_URL=postgresql://readonly_user:password@your-server:5432/your_database?sslmode=require
PG_SCHEMAS=public
# Optional, comma separated schema.table allowlist; empty = accessible ordinary tables in PG_SCHEMAS.
PG_ALLOWED_TABLES=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://your-provider.example/v1

# Automatic per-question stage records (default: reports/runs)
TEXT_TO_SQL_LOG_DIR=reports/runs

# Optional business schema descriptions; defaults to data/schema_descriptions.json if present
TEXT_TO_SQL_METADATA_PATH=data/schema_descriptions.json
